# =============================================================================
# PdM-Manager - Variables de Entorno
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=pdm123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=PdM

# -----------------------------------------------------------------------------
# CONFIGURACIÓN MQTT (Opcional)
# -----------------------------------------------------------------------------
# Broker MQTT (por defecto broker.hivemq.com)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# Tópico donde escuchar datos de sensores
MQTT_TOPIC=GL_Ingenieros/sensores/vibracion

# Credenciales MQTT (dejar vacío si no se requiere autenticación)
MQTT_USERNAME=
MQTT_PASSWORD=

# -----------------------------------------------------------------------------
# CONFIGURACIÓN WEB
# -----------------------------------------------------------------------------
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Clave secreta para JWT (cambiar en producción)
SECRET_KEY=dev-secret-key-change-me

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL SISTEMA
# -----------------------------------------------------------------------------
# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Entorno (development, production)
ENVIRONMENT=development

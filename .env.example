# =============================================================================
# PdM-Manager - Variables de Entorno
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# -----------------------------------------------------------------------------
# Configuración para desarrollo local (por defecto)
DB_USER=postgres
DB_PASSWORD=pdm123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=PdM

# Configuración para BD Universidad (descomenta para usar en producción)
# DB_HOST=10.1.11.230
# DB_PORT=5432
# DB_NAME=sensor
# DB_USER=consultadb
# DB_PASSWORD=tu_password_aqui

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL MODELO ML
# -----------------------------------------------------------------------------
# Rutas de los archivos del modelo (relativas al directorio raíz del proyecto)
MODEL_H5_PATH=modelo/modeloRNN_multiclase_v3_finetuned.h5
SCALER_PKL_PATH=scaler/scaler_RNN.pkl

# Intervalo de procesamiento de datos crudos en segundos (por defecto 30)
PROCESSING_INTERVAL=30

# -----------------------------------------------------------------------------
# CONFIGURACIÓN MQTT (Opcional)
# -----------------------------------------------------------------------------
# Broker MQTT (por defecto broker.hivemq.com)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# Tópico donde escuchar datos de sensores
MQTT_TOPIC=GL_Ingenieros/sensores/vibracion

# Credenciales MQTT (dejar vacío si no se requiere autenticación)
MQTT_USERNAME=
MQTT_PASSWORD=

# -----------------------------------------------------------------------------
# CONFIGURACIÓN WEB
# -----------------------------------------------------------------------------
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Clave secreta para JWT (cambiar en producción)
SECRET_KEY=dev-secret-key-change-me

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL SISTEMA
# -----------------------------------------------------------------------------
# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Entorno (development, production)
ENVIRONMENT=development
